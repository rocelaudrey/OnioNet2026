# Copy to .env for local development. In production these live ONLY in
# Vercel environment variables.
# Use a free MongoDB Atlas dev cluster (transactions need a replica set):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/onionet_dev
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-string
QR_HMAC_SECRET=replace-with-a-different-long-random-string

# Used only by `npm run seed` to create the Super Admin and the first Cooperative Admin.
SEED_SUPER_ADMIN_NAME=OnioNet Super Admin
SEED_SUPER_ADMIN_EMAIL=owner@onionet.test
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME=FAFOGGGA Admin
SEED_ADMIN_EMAIL=admin@fafoggga.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. The server always works in Philippine time (Asia/Manila) unless set.
# APP_TIME_ZONE=Asia/Manila
